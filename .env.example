# Copie para .env e preencha. Nunca versione o .env.
DOMINIO=command.vlsystems.com.br
APP_URL=https://command.vlsystems.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-longa
# Chave que cifra o segredo do 2FA no banco. Gere com: openssl rand -base64 32  (não troque depois de criar o admin)
APP_KEY=

# Alertas por e-mail (Resend). Sem estas variáveis, os alertas ficam só no painel.
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=VL Command <alertas@vlsystems.com.br>

# Asaas (cobrança). Sandbox: ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_URL=https://api.asaas.com/v3
# Mesmo token configurado no webhook do painel Asaas -> URL: https://SEU_DOMINIO/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=

# Sonda externa de uptime (gere com: openssl rand -hex 32)
SONDA_TOKEN=
